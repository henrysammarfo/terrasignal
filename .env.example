# ============== TerraSignal Python Agent ==============
# Copy this to .env and fill in your values. Never commit .env.

# --- Flock AI (required) ---
# Get key: https://platform.flock.io/ → API Keys
# Docs: https://docs.flock.io/
FLOCK_API_KEY=YOUR_FLOCK_API_KEY
# Model ID from Flock marketplace (cheap + good: deepseek-v3.2 or qwen3-30b-a3b-instruct-2507)
FLOCK_MODEL=qwen3-30b-a3b-instruct-2507

# --- Slack (required for delivery) ---
# Create Incoming Webhook: Slack workspace → App → Incoming Webhooks → Add to #channel
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# --- Supabase webhook (required for dashboard) ---
# So the React dashboard shows intel. From Supabase: Project URL + anon key or use Functions URL.
SUPABASE_WEBHOOK_URL=https://YOUR_PROJECT_REF.supabase.co/functions/v1/webhook-receiver
# Must match WEBHOOK_API_KEY in Supabase Edge Function secrets
WEBHOOK_API_KEY=your-webhook-secret
# Optional: UUID of the Supabase Auth user to attach reports to (so they show in that user's dashboard)
# SUPABASE_AGENT_USER_ID=

# --- Optional: OpenClaw (TCC Challenge) ---
# If set, high/critical alerts are also sent here. Leave empty if not set up yet.
# OPENCLAW_GATEWAY_URL=
# OPENCLAW_CHANNEL=default

# --- Agent behavior ---
POLL_INTERVAL_MINUTES=15
MIN_RELEVANCE_SCORE=0.65
MAX_CLOUD_COVER=20
BASELINE_YEARS_BACK=1
# Use Data API for Sentinel-2 (no rasterio). Set to 1 on Windows if the native stack crashes.
# USE_SENTINEL_DATA_API=1

# --- Optional: Email (leave empty to skip) ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
