# React (Vite) — copy to .env or .env.local and fill in.
# Get values from Supabase: Project Settings → API (URL, anon key) and use the project ref from the URL.

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key
VITE_SUPABASE_PROJECT_ID=YOUR_PROJECT_REF
