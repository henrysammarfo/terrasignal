WEBHOOK_API_KEY=
# System agent user UUID: paste the UUID after creating agent@terrasignal.local in Supabase Auth and running the UPDATE below.
SUPABASE_AGENT_USER_ID=323b750d-d04a-49ea-99e0-ee71e752f2ef

# --- OpenClaw (optional, TCC Challenge) ---
OPENCLAW_GATEWAY_URL=
OPENCLAW_CHANNEL=default

# --- Agent behavior ---
POLL_INTERVAL_MINUTES=15
MIN_RELEVANCE_SCORE=0.65
MAX_CLOUD_COVER=20
BASELINE_YEARS_BACK=1
# Use Data API for Sentinel-2 on Windows (avoids rasterio crash). Use 1 on Windows.
USE_SENTINEL_DATA_API=1

# --- Email (optional, leave empty to skip) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

